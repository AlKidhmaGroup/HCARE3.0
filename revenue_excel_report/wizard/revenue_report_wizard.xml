<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record model="ir.ui.view" id="revenue_excel_report_wizard">
        <field name="name">Revenue Report</field>
        <field name="model">revenue.excel.report.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Revenue Report">
                <group>
                    <group>
                        <field name="date_start" attrs="{'invisible':[('state','=','get')]}"/>
                        <field name="doctor" attrs="{'invisible':[('state','=','get')]}"/>
                        <field name="patient_type" attrs="{'invisible':[('state','=','get')]}"/>
                        <field name="company_id" attrs="{'invisible':[('state','=','get')]}"/>
                        <field name="data" readonly="1" filename="name" attrs="{'invisible':[('state','=','choose')]}"/>
                    </group>
                    <group>
                        <field name="date_end" attrs="{'invisible':[('state','=','get')]}"/>
                        <field name="patient" attrs="{'invisible':[('state','=','get')]}"/>
                        <field name="insurance_company" attrs="{'invisible':['|', ('state','=','get'),
                         ('patient_type', 'in', ('self','both'))]}"/>
						<field name="name" invisible="1"/>
						<field name="state" invisible="1"/>
						<field name="date_type" attrs="{'invisible':[('state','=','get')]}"/>
                    </group>
                </group>
                <footer>
                    <button string="Print Report" type="object" name="generate_backlog_excel_report"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_revenue_excel_report_wizard" name="Revenue Report"
                res_model="revenue.excel.report.wizard" view_mode="form" target="new"/>

    <menuitem action="action_revenue_excel_report_wizard" id="menu_revenue_excel_report_wizard"
              parent="pragtech_dental_management.dental_report_menu" sequence="3"/>
</odoo>
