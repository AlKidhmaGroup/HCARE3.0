<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_payment_sms" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.payment.sms</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="pragtech_dental_management.res_config_settings_view_form_hcare"/>
            <field name="arch" type="xml">
                <div data-key="hcare" position="inside">
                    <h2>Payment SMS</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            	<field name="send_payment_sms"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="send_payment_sms"/>
                            </div>
                        </div>
                         <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            	<field name="confirmed_appt_only"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="confirmed_appt_only"/>
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>